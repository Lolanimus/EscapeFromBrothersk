[configuration]

entry_symbol = "escape_from_brothersk_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "res://bin/libescape_from_brothersk.macos.template_debug.framework"
macos.release = "res://bin/libescape_from_brothersk.macos.template_release.framework"
linux.debug.x86_64 = "res://bin/libescape_from_brothersk.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libescape_from_brothersk.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libescape_from_brothersk.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libescape_from_brothersk.windows.template_release.x86_64.dll"

